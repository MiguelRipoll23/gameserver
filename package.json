{
  "name": "gameserver",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "generate:openapi": "node --env-file=.env --import tsx --import ./scripts/register-openapi-loader.mjs scripts/generate-openapi-schema.ts",
    "migrate": "node --env-file=.env --import tsx scripts/migrate-database.ts",
    "predeploy": "node --env-file=.env --import tsx scripts/predeploy.ts",
    "register-discord-commands": "node --env-file=.env --import tsx scripts/register-discord-commands.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.5.1",
    "@needle-di/core": "^1.1.3",
    "@scalar/hono-api-reference": "^0.11.12",
    "@simplewebauthn/server": "^13.3.2",
    "discord-interactions": "^4.4.0",
    "drizzle-orm": "beta",
    "hono": "^4.13.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "drizzle-kit": "beta",
    "tsx": "^4.19.2",
    "typescript": "^5.5.2",
    "wrangler": "^4.119.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260801.1": true
  }
}
