# API authentication
# Random string used to sign JWT tokens for API authentication
JWT_SECRET="your secret phrase here"

# Direct PostgreSQL connection string used only by local/CI migration commands.
# The deployed Worker uses the DATABASE_HYPERDRIVE binding instead.
DATABASE_URL="connection string here"
# Wrangler local Hyperdrive binding (use the same value for local `wrangler dev`).
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_DATABASE_HYPERDRIVE="connection string here"

# WebAuthn configuration
# RP_NAME: The display name for your relying party (server)
# RP_NAME="Game server API"
# RP_ALLOWED_ORIGINS: Comma-separated list of allowed origins for WebAuthn
# Supports wildcards (e.g., https://preview-*.example.com for preview deployments)
# Examples:
#   - Local development: "http://localhost:8000,http://localhost:8080"
#   - Production + previews: "https://example.com,https://*.example.com"
#   - Multiple environments: "https://staging.example.com,https://production.example.com"
RP_ALLOWED_ORIGINS="http://localhost:8000,http://localhost:8080"

# WebRTC configuration
# Cloudflare Calls has free tier!
CLOUDFLARE_CALLS_URL=""
CLOUDFLARE_CALLS_TOKEN=""

# Discord serverless bot (HTTP interactions) - OPTIONAL
# If not set, the start log warns and the slash command endpoints are disabled.

# RUNTIME vars (required for the interactions endpoint to work):
# Bot token from the Discord Developer Portal
DISCORD_BOT_TOKEN=""
# Public key (hex) of the Discord application, used to verify interactions
DISCORD_PUBLIC_KEY=""

# Optional (has a default): Discord role names allowed to use /alert and /news
# (comma-separated). Defaults to "moderator,manager".
DISCORD_ALLOWED_ROLE_NAMES="moderator,manager"

# NOT used by the Worker runtime - only needed to register slash commands via
# `npm run register-discord-commands` (a one-off step after setting up the app).
# Application ID of the Discord application
DISCORD_APPLICATION_ID=""
