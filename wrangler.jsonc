{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gameserver",
	"main": "src/main.ts",
	"compatibility_date": "2026-08-07",
	"compatibility_flags": ["nodejs_compat"],
	"upload_source_maps": true,
	"keep_vars": true,

	// Origins allowed to start a WebAuthn ceremony (see WebAuthnUtils). Browsers
	// only accept a foreign `rpId` from an origin listed in this Worker's
	// `/.well-known/webauthn` manifest, so the management console's own origin
	// has to be here: it relays the passkey flow to this Worker while the
	// ceremony runs against the console's domain. The Vercel entries are the
	// game client and the previous console deployment.
	"vars": {
		"RP_ALLOWED_ORIGINS": "https://gameserver-console.miguelripoll23.workers.dev,https://gameserver-console.vercel.app,https://hoodball.vercel.app,https://aircombat.vercel.app,http://localhost:8080,http://localhost:5173"
	},

	"assets": {
		"directory": "./static"
	},

	"triggers": {
		"crons": ["0 0 * * *"]
	},

	"kv_namespaces": [
		{
			"binding": "GAMESERVER_KV",
			"id": "8c1d5c1b984f4cdf98ec8be7c2a123b1"
		}
	],

	"observability": {
		"enabled": true
	},

	"exports": {
		"WebSocketDurableObject": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	},

	"durable_objects": {
		"bindings": [
			{
				"class_name": "WebSocketDurableObject",
				"name": "WEBSOCKET_DURABLE_OBJECT"
			}
		]
	},

	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "d82b1240ee88426890b56aa284666c08"
		}
	],

	"previews": {
		"kv_namespaces": [
			{
				"binding": "GAMESERVER_KV",
				"id": "0be91fae94a8424f85d489a3b1242f5b"
			}
		],
		"durable_objects": {
			"bindings": [
				{
					"class_name": "WebSocketDurableObject",
					"name": "WEBSOCKET_DURABLE_OBJECT"
				}
			]
		},
		"hyperdrive": [
			{
				"binding": "HYPERDRIVE",
				"id": "2667e278a39346acb33074be05cba835"
			}
		]
	}
}
