{
  "name": "gameserver",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/wrangler/bin/wrangler.js dev",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "predeploy": "node --env-file=.env --import tsx scripts/predeploy.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate-database.ts",
    "openapi:generate": "node --env-file=.env --import tsx --import ./scripts/register-openapi-loader.mjs scripts/generate-openapi-schema.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.0",
    "@needle-di/core": "^1.1.3",
    "@scalar/hono-api-reference": "^0.11.14",
    "@simplewebauthn/server": "^13.3.2",
    "discord-interactions": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.2",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "wrangler": "^4.123.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260801.1": true
  }
}
