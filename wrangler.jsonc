{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gameserver",
	"main": "src/main.ts",
	"compatibility_date": "2026-08-07",
	"compatibility_flags": ["nodejs_compat"],
	"upload_source_maps": true,
	"keep_vars": true,

	"assets": {
		"directory": "./static"
	},

	"triggers": {
		"crons": ["0 0 * * *"]
	},

	"kv_namespaces": [
		{
			"binding": "GAMESERVER_KV",
			"id": "0be91fae94a8424f85d489a3b1242f5b"
		}
	],

	"observability": {
		"enabled": true
	},

	"exports": {
		"WebSocketDurableObject": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	},

	"durable_objects": {
		"bindings": [
			{
				"class_name": "WebSocketDurableObject",
				"name": "WEBSOCKET_V1_DO"
			}
		]
	},

	"hyperdrive": [
		{
			"binding": "DATABASE_HYPERDRIVE",
			"id": "d82b1240ee88426890b56aa284666c08"
		}
	],

	"env": {
		"staging": {
			"exports": {
				"WebSocketDurableObject": {
					"type": "durable-object",
					"storage": "sqlite"
				}
			},
			"durable_objects": {
				"bindings": [
					{
						"class_name": "WebSocketDurableObject",
						"name": "WEBSOCKET_V1_DO"
					}
				]
			},
			"kv_namespaces": [
				{
					"binding": "GAMESERVER_KV",
					"id": "35aaedeba2604e6da7862014efcca636"
				}
			],
			"hyperdrive": [
				{
					"binding": "DATABASE_HYPERDRIVE",
					// Staging intentionally shares production Hyperdrive until a separate
					// database resource is provisioned.
					"id": "d82b1240ee88426890b56aa284666c08"
				}
			]
		},
		"production": {
			"name": "gameserver",
			"exports": {
				"WebSocketDurableObject": {
					"type": "durable-object",
					"storage": "sqlite"
				}
			},
			"durable_objects": {
				"bindings": [
					{
						"class_name": "WebSocketDurableObject",
						"name": "WEBSOCKET_V1_DO"
					}
				]
			},
			"kv_namespaces": [
				{
					"binding": "GAMESERVER_KV",
					"id": "8c1d5c1b984f4cdf98ec8be7c2a123b1"
				}
			],
			"hyperdrive": [
				{
					"binding": "DATABASE_HYPERDRIVE",
					"id": "d82b1240ee88426890b56aa284666c08"
				}
			]
		}
	}
}
