# =============================================================================
# Environment variables
#
# Sections:
#   1. REQUIRED - the app (or its local tooling) will not work without these.
#   2. OPTIONAL - safe to leave unset; each documents its default behaviour.
#
# Secrets (marked SECRET) must never be committed or shared. For deployed
# Workers, set them with `npx wrangler secret put <NAME>` instead of putting
# them in this file. Placeholders below (e.g. "your-...-here") are NOT real
# values.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# API authentication
# SECRET - Random string used to sign JWT tokens for API authentication.
# Generate one with: `openssl rand -base64 32`
JWT_SECRET="your-secret-phrase-here"

# Direct PostgreSQL connection string used only by local/CI migration commands
# (`npm run migrate`, `npm run predeploy`). The deployed Worker uses the
# HYPERDRIVE binding instead (its target id differs per environment).
DATABASE_URL="postgresql://user:password@host:5432/database"

# Wrangler local Hyperdrive connection string: lets `npm run dev` connect to the
# database. The dev script loads this file into the process environment, which is
# how wrangler reads CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_<BINDING_NAME>.
# The same var works for every environment because the binding name stays HYPERDRIVE.
# Required for local development only (not used by migrations or the deployed Worker).
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgresql://user:password@host:5432/database"

# -----------------------------------------------------------------------------
# OPTIONAL (the server has a working default when unset)
# -----------------------------------------------------------------------------

# WebAuthn configuration
# RP_NAME - display name of the relying party (server) shown in passkey prompts.
# Defaults to "Game server" when unset.
RP_NAME="Game server"

# RP_ID - the relying party ID (domain) for WebAuthn, e.g. "example.com".
# Must be a registrable domain suffix of the deployment host.
# Defaults to "localhost" when unset.
RP_ID="localhost"

# RP_ALLOWED_ORIGINS - comma-separated list of allowed origins for WebAuthn.
# Supports wildcards (e.g., https://preview-*.example.com for preview deployments).
# Examples:
#   - Local development: "http://localhost:8000,http://localhost:8080"
#   - Production + previews: "https://example.com,https://*.example.com"
#   - Multiple environments: "https://staging.example.com,https://production.example.com"
# Defaults to "http://localhost:8000" when unset.
RP_ALLOWED_ORIGINS="http://localhost:8000,http://localhost:8080"

# GAME_URL - public base URL players use to reach the game, used when the
# server sends players links/notifications.
# Defaults to "http://localhost:8080" when unset.
GAME_URL="http://localhost:8080"

# WebRTC configuration (Cloudflare Calls) - OPTIONAL
# If unset, the server falls back to default public ICE servers.
CLOUDFLARE_CALLS_URL="https://rtc.live.cloudflare.com/v1/turn/keys/<key-id>/credentials/generate"
# SECRET - Cloudflare Calls API token.
CLOUDFLARE_CALLS_TOKEN="your-calls-token-here"

# Discord serverless bot (HTTP interactions) - OPTIONAL
# If not set, the start log warns and the slash command endpoints are disabled.

# Runtime vars (required for the interactions endpoint to work):
# SECRET - bot token from the Discord Developer Portal
DISCORD_BOT_TOKEN="your-bot-token-here"
# SECRET - public key (hex) of the Discord application, used to verify interactions
DISCORD_PUBLIC_KEY="your-public-key-here"

# Optional (has a default): Discord role names allowed to use /alert and /news
# (comma-separated). Defaults to "moderator,manager".
DISCORD_ALLOWED_ROLE_NAMES="moderator,manager"

# NOT used by the Worker runtime - only needed to register slash commands via
# `npm run register-discord-commands` (a one-off step after setting up the app).
# Application ID of the Discord application
DISCORD_APPLICATION_ID="your-application-id-here"
